{
  "name": "PlusTab - Minimal New Tab",
  "version": "3.2.3",
  "description": "A Minimal and Customisable New Tab Page",
  "manifest_version": 3,
  "chrome_url_overrides": {
    "newtab": "./index.html"
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
